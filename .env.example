# Copiar a backend/.env y completar. Las claves viven SOLO en el backend.

# Local (docker compose). En Supabase usar la connection string con el driver asyncpg:
# postgresql+asyncpg://postgres.<ref>:<password>@<host>:5432/postgres
DATABASE_URL=postgresql+asyncpg://radar:radar@localhost:5433/radar

YOUTUBE_API_KEY=
BRAVE_API_KEY=

# Jev (TypeSafe): clasificación por pieza y verificación. Versión fijada, no un alias (CLAUDE.md §7).
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0

# LLM: evalúa cada tema (audience fit) y redacta (why_it_matters, briefs). Modelo pendiente (Melkin).
LLM_API_KEY=
LLM_MODEL=

CORS_ALLOWED_ORIGINS=http://localhost:5173
MCP_PUBLIC_URL=
APP_ENV=local
# Ejecución de analyze fijada para la demo; vacío = la última correcta
DEMO_RUN_ID=
