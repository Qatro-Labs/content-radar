# Copiar a backend/.env y completar. Las claves viven SOLO en el backend.

# Local (docker compose). En Supabase usar la connection string con el driver asyncpg:
# postgresql+asyncpg://postgres.<ref>:<password>@<host>:5432/postgres
DATABASE_URL=postgresql+asyncpg://radar:radar@localhost:5433/radar

YOUTUBE_API_KEY=
# Brave Search: sin colector todavía; no se usa.
BRAVE_API_KEY=
# TikTok, Reddit e Instagram (ScrapeCreators, 1 crédito por llamada). Sin valor, esas fuentes se omiten.
SCRAPECREATORS_API_KEY=

# Jev (TypeSafe): clasificación por pieza y verificación. Versión fijada, no un alias (CLAUDE.md §7).
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
# Jev verifica cada afirmación de «por qué importa». false hasta validarlo (docs/jev.md §3); nunca vacío.
JEV_VERIFY_CLAIMS=false

# LLM (clave de Anthropic): evalúa cada tema (audience fit) y redacta (why_it_matters, briefs, agente).
# Sin clave o sin modelo, analyze deja el fit y el score en null. El modelo debe tener precio en
# data/pricing.yaml; si no, el coste queda en null.
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5

CORS_ALLOWED_ORIGINS=http://localhost:5173
# URL pública del MCP, p. ej. https://<dominio-de-railway>/mcp. Solo se aceptan peticiones con
# ese Host o uno local: vacía en Railway = 421 en todo el MCP (docs/mcp.md).
MCP_PUBLIC_URL=
APP_ENV=local
# Ejecución de analyze fijada para la demo; vacío = la última correcta
DEMO_RUN_ID=
