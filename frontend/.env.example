# URL pública de la API en producción (Railway). En desarrollo se deja vacía: Vite hace de proxy de /api.
VITE_API_BASE_URL=
# Login opcional con Supabase Auth (correo y contraseña; las cuentas se crean a mano en Supabase).
# Sin URL o sin clave anónima, la app funciona igual y /login dice "Login no configurado".
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# "true" exige iniciar sesión para ver la app. Vacío o cualquier otro valor: login opcional.
VITE_AUTH_REQUIRED=
